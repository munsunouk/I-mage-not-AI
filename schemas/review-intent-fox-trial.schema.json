{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fox trial review intent source",
  "type": "object",
  "required": ["schema_version", "intents_by_check"],
  "properties": {
    "schema_version": {
      "const": "i-mage-not-ai/review-intent-fox-trial/1"
    },
    "intents_by_check": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "purpose", "threshold_source"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "feature_id": { "type": ["string", "null"] },
          "purpose": { "type": "string", "minLength": 1 },
          "threshold_source": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
