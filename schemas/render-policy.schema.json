{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://munsunouk.github.io/I-mage-not-AI/render-policy.schema.json",
  "title": "i_mage_not_ai render policy",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "min_capture_count": { "type": "integer", "minimum": 2 },
    "max_changed_pixel_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "pixel_delta_threshold": { "type": "integer", "minimum": 1, "maximum": 255 },
    "event_times": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["time", "tolerance"],
        "properties": {
          "time": { "type": "number", "minimum": 0 },
          "tolerance": { "type": "number", "minimum": 0 },
          "before_frames": { "type": "integer", "minimum": 0 },
          "after_frames": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "flash": { "type": "object" },
    "roi_oracles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["frame_index", "region", "reference"],
        "properties": {
          "frame_index": { "type": "integer", "minimum": 0 },
          "region": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "integer", "minimum": 0 }
          },
          "reference": { "type": "string", "minLength": 1 },
          "max_changed_pixel_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
          "pixel_delta_threshold": { "type": "integer", "minimum": 1, "maximum": 255 },
          "match_mode": { "enum": ["ratio", "hash"] }
        },
        "additionalProperties": false
      }
    },
    "trace_motion_bound": {
      "type": "object",
      "properties": {
        "pixels_per_engine_unit": { "type": "number", "exclusiveMinimum": 0 },
        "margin": { "type": "number", "exclusiveMinimum": 0 },
        "centroid_luma_threshold": { "type": "integer", "minimum": 0, "maximum": 255 },
        "max_render_motion_px": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
