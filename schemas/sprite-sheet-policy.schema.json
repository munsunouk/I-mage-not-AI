{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://munsunouk.github.io/I-mage-not-AI/sprite-sheet-policy.schema.json",
  "title": "i_mage_not_ai sprite sheet policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["frame_width", "frame_height"],
  "minProperties": 3,
  "properties": {
    "layout": { "enum": ["horizontal_strip", "grid"] },
    "frame_width": { "type": "integer", "minimum": 1 },
    "frame_height": { "type": "integer", "minimum": 1 },
    "columns": { "type": "integer", "minimum": 1 },
    "frame_count": { "type": "integer", "minimum": 1 },
    "alpha_threshold": { "type": "integer", "minimum": 0, "maximum": 255 },
    "margin_left": { "type": "integer", "minimum": 0 },
    "margin_top": { "type": "integer", "minimum": 0 },
    "margin_right": { "type": "integer", "minimum": 0 },
    "margin_bottom": { "type": "integer", "minimum": 0 },
    "gap_x": { "type": "integer", "minimum": 0 },
    "gap_y": { "type": "integer", "minimum": 0 },
    "forbid_empty_cells": { "type": "boolean" },
    "forbid_duplicate_cells": { "type": "boolean" },
    "min_transparent_inner_border_px": { "type": "integer", "minimum": 0 },
    "min_occupied_pixels": { "type": "integer", "minimum": 1 },
    "include_cell_metadata": { "type": "boolean" },
    "max_file_bytes": { "type": "integer", "minimum": 1 },
    "max_pixel_count": { "type": "integer", "minimum": 1 },
    "max_cell_count": { "type": "integer", "minimum": 1 },
    "required_bit_depth": { "enum": [8] },
    "max_baseline_y_variance": { "type": "number", "minimum": 0 },
    "max_bbox_height_variance": { "type": "number", "minimum": 0 },
    "max_inter_frame_changed_pixel_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "max_loop_changed_pixel_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "include_foot_metrics": { "type": "boolean" },
    "max_ground_line_y_variance": { "type": "number", "minimum": 0 },
    "max_feet_center_x_variance": { "type": "number", "minimum": 0 },
    "pixel_delta_threshold": { "type": "integer", "minimum": 1, "maximum": 255 },
    "require_palette_subset_of_first_frame": { "type": "boolean" },
    "reference_frame_index": { "type": "integer", "minimum": 0 },
    "max_reference_changed_pixel_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
